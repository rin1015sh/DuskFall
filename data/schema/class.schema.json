          "$comment": "prepared 준비(클레릭) · spellbook 주문서(위저드) · known 아는 주문(레인저·워락 등 — 준비와 같게 다룬다)",
          "enum": [
            "prepared",
            "spellbook",
            "known"
          ]
        },
        "list": {
          "$comment": "주문 목록 id — 주문 데이터 classes에 이 값이 있는 주문만 고를 수 있다",
          "type": "string"
        },
        "extra_lists": {
          "$comment": "클래스 레벨이 되면 더 열리는 주문 목록 {level, lists}(바드 마법의 비밀)",
          "type": "object"
        },
        "swap": {
          "$comment": "준비 주문 교체(spell_prep.gd): long_rest 긴 휴식 뒤 바꿀 수(-1 전부, 기본 -1), level_up 레벨 업 때 바꿀 수(기본 0). 창은 다음 전투가 시작되면 닫힌다",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "long_rest": {
              "type": "integer",
              "minimum": -1
            },
            "level_up": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "slot_recharge": {
          "$comment": "슬롯 회복: long 긴 휴식(기본) · short 짧은 휴식(계약형 — 워락)",
          "enum": [
            "long",
            "short"
          ]
        },
        "cantrips": {
          "type": "object"
        },
        "prepared": {
          "type": "object"
        },
        "slots": {
          "$comment": "레벨 → [1레벨 슬롯 수, 2레벨, …]. 절반 시전자는 표만 다르다",
          "type": "object"
        },
        "spellbook": {
          "type": "object"
        },
        "progression": {
          "$comment": "멀티클래스 시전 레벨 계산: full(전 레벨)·half(절반 올림)·pact(계약 마법 — 따로)",
          "enum": [
            "full",
            "half",
            "pact"
          ]
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "max",
          "recharge"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "max": {
            "type": [
              "integer",
              "string",
              "object"
            ]
          },
          "recharge": {
            "$comment": "short·short_one·long, 또는 레벨표 {\"1\": \"long\", \"5\": \"short\"}",
            "oneOf": [
              {
                "enum": [
                  "short",
                  "short_one",
                  "long"
                ]
              },
              {
                "type": "object",
                "additionalProperties": {
                  "enum": [
                    "short",
                    "short_one",
                    "long"
                  ]
                }
              }
            ]
          },
          "name": {
            "type": "object",
            "required": [
              "ko",
              "en"
            ],
            "additionalProperties": false,
            "properties": {
              "ko": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "en": {
                "type": "string"
              }
            }
          },
          "subclass": {
            "type": "string"
          },
          "add": {
            "type": "boolean"
          }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "subclasses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "level",
          "features",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "object",
            "required": [
              "ko",
              "en"
            ],
            "additionalProperties": false,
            "properties": {
              "ko": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "en": {
                "type": "string"
              }
            }
          },
          "level": {
            "type": "integer"
          },
          "features": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/feature"
            }
          },
          "always_prepared": {
            "type": "object"
          },
          "source": {
            "enum": [
              "SRD 5.2.1",
              "original"
            ]
          },
          "spellcasting": {
            "type": "object"
          }
        }
      }
    },
    "starting_equipment": {
      "type": "object"
    },
    "sprite_parts": {
      "type": "array"
    },
    "source": {
      "enum": [
        "SRD 5.2.1",
        "original"
      ]
    },
    "default_build": {
      "$comment": "추천 빌드(동료·시험·생성 화면 시작값): 생성 명세(character_builder.gd 머리말)에서 class·level·team을 뺀 것.",
      "type": "object",
      "required": [
        "species",
        "background",
        "scores",
        "bonus",
        "skills"
      ]
    },
    "ai_role": {
      "$comment": "AI 역할(scripts/ai): melee 근접 · ranged 원거리 · caster 시전 · healer 치유",
      "enum": [
        "melee",
        "ranged",
        "caster",
        "healer"
      ]
    },
    "art": {
      "$comment": "임시 그림: 걷기 시트(assets/actors)",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sheet": {
          "type": "string"
        }
      }
    },
    "color": {
      "$comment": "클래스 기능 아이콘 색(#rrggbb)",
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "always_prepared": {
      "$comment": "클래스 레벨 → 항상 준비 주문(준비 수에 세지 않음)",
      "type": "object"
    },
    "multiclass": {
      "$comment": "멀티클래스로 이 클래스에 처음 들어올 때 얻는 숙련(SRD 'As a Multiclass Character'): weapon_training, armor_training, skills{choose, from: any|class}. 생명 주사위는 늘 얻는다",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weapon_training": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "armor_training": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "object",
          "properties": {
            "choose": {
              "type": "integer"
            },
            "from": {
              "enum": [
                "any",
                "class"
              ]
            }
          }
        }
      }
    }
  }
