{
  "$comment": "주문 파일(data/content/spells.json) 스키마. 룰북 8단계 '데이터 스키마'와 6단계 주문 변환표 기준. 상태·표면·클래스·종족 ID 참조와 script 파일 존재는 tools/data_validator.gd가 따로 검사한다.",
  "type": "object",
  "required": [
    "schema",
    "attribution",
    "spells"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "spell_v1"
    },
    "note_ko": {
      "type": "string"
    },
    "attribution": {
      "type": "string",
      "minLength": 1
    },
    "spells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/spell"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "text": {
      "type": "object",
      "required": [
        "ko",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "ko": {
          "type": [
            "string",
            "null"
          ]
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dice": {
      "type": "string",
      "pattern": "^-?([0-9]+d[0-9]+([+-][0-9]+)?|[0-9]+)$"
    },
    "ability": {
      "enum": [
        "str",
        "dex",
        "con",
        "int",
        "wis",
        "cha"
      ]
    },
    "damage_type": {
      "enum": [
        "acid",
        "bludgeoning",
        "cold",
        "fire",
        "force",
        "lightning",
        "necrotic",
        "piercing",
        "poison",
        "psychic",
        "radiant",
        "slashing",
        "thunder",
        "chosen",
        "weapon"
      ]
    },
    "tiles_count": {
      "type": "integer",
      "minimum": 0
    },
    "effect": {
      "$comment": "효과 하나. type은 룰북 8단계 효과 종류 목록 안에서만 고른다. 나머지 필드는 종류마다 달라 여기서는 공통 필드만 본다.",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "damage",
            "heal",
            "temp_hp",
            "apply_condition",
            "remove_condition",
            "create_surface",
            "create_cloud",
            "push",
            "teleport",
            "summon",
            "modify",
            "advantage",
            "reroll",
            "grant_action",
            "resource",
            "light",
            "dialogue_unlock"
          ]
        },
        "dice": {
          "$ref": "#/$defs/dice"
        },
        "damage_type": {
          "$ref": "#/$defs/damage_type"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "scale": {
          "type": "number",
          "minimum": 0
        },
        "tiles": {
          "$ref": "#/$defs/tiles_count"
        }
      }
    },
    "effect_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "spell": {
      "type": "object",
      "required": [
        "id",
        "name",
        "level",
        "school",
        "classes",
        "granted_by",
        "cast",
        "range",
        "area",
        "duration",
        "concentration",
        "components",
        "effects",
        "game_status",
        "review",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "school": {
          "enum": [
            "abjuration",
            "conjuration",
            "divination",
            "enchantment",
            "evocation",
            "illusion",
            "necromancy",
            "transmutation"
          ]
        },
        "classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "granted_by": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "cast": {
          "type": "object",
          "required": [
            "cost",
            "ritual",
            "explore_only"
          ],
          "additionalProperties": false,
          "properties": {
            "cost": {
              "enum": [
                "action",
                "bonus_action",
                "reaction",
                "explore"
              ]
            },
            "ritual": {
              "type": "boolean"
            },
            "explore_only": {
              "type": "boolean"
            },
            "trigger": {
              "$ref": "#/$defs/id"
            },
            "trigger_en": {
              "type": "string"
            }
          }
        },
        "range": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "tiles"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "tiles"
                },
                "tiles": {
                  "$ref": "#/$defs/tiles_count"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "touch",
                    "self",
                    "map",
                    "unlimited"
                  ]
                }
              }
            }
          ]
        },
        "area": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "shape"
              ],
              "additionalProperties": false,
              "properties": {
                "shape": {
                  "enum": [
                    "sphere",
                    "cylinder",
                    "emanation",
                    "cone",
                    "line",
                    "cube",
                    "square"
                  ]
                },
                "radius_tiles": {
                  "$ref": "#/$defs/tiles_count"
                },
                "size_tiles": {
                  "$ref": "#/$defs/tiles_count"
                },
                "length_tiles": {
                  "$ref": "#/$defs/tiles_count"
                },
                "width_tiles": {
                  "$ref": "#/$defs/tiles_count"
                },
                "mask": {
                  "enum": [
                    "circle"
                  ]
                }
              }
            }
          ]
        },
        "duration": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "turns"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "turns"
                },
                "turns": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "instant",
                    "until_long_rest",
                    "permanent"
                  ]
                }
              }
            }
          ]
        },
        "concentration": {
          "type": "boolean"
        },
        "components": {
          "type": "object",
          "required": [
            "verbal",
            "somatic",
            "material_cost_gp",
            "consumed"
          ],
          "additionalProperties": false,
          "properties": {
            "verbal": {
              "type": "boolean"
            },
            "somatic": {
              "type": "boolean"
            },
            "material_cost_gp": {
              "type": "integer",
              "minimum": 0
            },
            "consumed": {
              "type": "boolean"
            }
          }
        },
        "effects": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "check": {
              "type": "object",
              "required": [
                "type"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "attack",
                    "save"
                  ]
                },
                "kind": {
                  "enum": [
                    "melee",
                    "ranged"
                  ]
                },
                "ability": {
                  "$ref": "#/$defs/ability"
                },
                "dc": {
                  "enum": [
                    "spell"
                  ]
                }
              }
            },
            "hit": {
              "$ref": "#/$defs/effect_list"
            },
            "fail": {
              "$ref": "#/$defs/effect_list"
            },
            "success": {
              "$ref": "#/$defs/effect_list"
            },
            "apply": {
              "$ref": "#/$defs/effect_list"
            }
          }
        },
        "tiles": {
          "$comment": "칸 반응(룰북 8단계 판정 순서 11번). 생물에게 거는 효과 목록과 따로 둔다.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "tile_damage",
                  "ignite_flammable_object"
                ]
              },
              "damage_type": {
                "$ref": "#/$defs/damage_type"
              },
              "radius_tiles": {
                "$ref": "#/$defs/tiles_count"
              }
            }
          }
        },
        "targets_max": {
          "type": "integer",
          "minimum": 1
        },
        "upcast": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "per_slot_level": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "dice_add": {
                  "$ref": "#/$defs/dice"
                },
                "extra_targets": {
                  "type": "integer",
                  "minimum": 1
                },
                "script": {
                  "type": "boolean"
                },
                "en": {
                  "type": "string"
                }
              }
            },
            "cantrip_scaling": {
              "type": "object",
              "additionalProperties": false,
              "patternProperties": {
                "^[0-9]+$": {
                  "$ref": "#/$defs/dice"
                }
              }
            }
          }
        },
        "game_status": {
          "enum": [
            "included",
            "excluded_v1",
            "candidate_exclusion"
          ]
        },
        "review": {
          "type": "boolean"
        },
        "script": {
          "$ref": "#/$defs/id"
        },
        "notes_ko": {
          "type": "string"
        },
        "source": {
          "enum": [
            "SRD 5.2.1",
            "original"
          ]
        },
        "repeat_save": {
          "type": "boolean"
        }
      }
    }
  }
}