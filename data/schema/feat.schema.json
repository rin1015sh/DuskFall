{
  "$comment": "feat 파일 스키마(룰북 6단계).",
  "type": "object",
  "required": [
    "schema",
    "feats"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "feat_v1"
    },
    "note_ko": {
      "type": "string"
    },
    "feats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "object",
          "required": [
            "ko",
            "en"
          ],
          "additionalProperties": false,
          "properties": {
            "ko": {
              "type": [
                "string",
                "null"
              ]
            },
            "en": {
              "type": "string"
            }
          }
        },
        "category": {
          "enum": [
            "general",
            "fighting_style"
          ]
        },
        "hook": {
          "type": "string"
        },
        "also_hooks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "script": {
          "type": "string"
        },
        "tags": {
          "type": "array",
