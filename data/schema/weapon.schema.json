{
  "$comment": "무기 파일 스키마(룰북 8단계 무기 예시, SRD 5.2.1 Weapons).",
  "type": "object",
  "required": [
    "schema",
    "weapons"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "weapon_v1"
    },
    "note_ko": {
      "type": "string"
    },
    "weapons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "category",
          "damage",
          "damage_type",
          "properties",
          "weight_kg",
          "price_gp",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "object",
            "required": [
              "ko",
              "en"
            ],
            "additionalProperties": false,
            "properties": {
              "ko": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "en": {
                "type": "string"
              }
            }
          },
          "category": {
            "enum": [
              "simple_melee",
              "simple_ranged",
              "martial_melee",
              "martial_ranged"
            ]
          },
          "damage": {
            "type": "string",
            "pattern": "^([0-9]+d[0-9]+|[0-9]+)$"
          },
          "damage_type": {
            "enum": [
              "bludgeoning",
              "piercing",
              "slashing",
              "fire",
              "psychic"
            ]
          },
          "properties": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "ammunition",
                "finesse",
                "heavy",
                "light",
                "loading",
                "reach",
                "thrown",
                "two_handed",
                "versatile"
              ]
            }
          },
          "versatile_damage": {
            "type": "string",
            "pattern": "^[0-9]+d[0-9]+$"
          },
          "range_tiles": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "ammunition": {
            "type": "string"
          },
          "weight_kg": {
            "type": "number",
            "minimum": 0
          },
          "price_gp": {
            "type": "number",
            "minimum": 0
          },
          "material": {
            "type": "string"
          },
          "sprite_parts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "enum": [
              "SRD 5.2.1",
              "original"
            ]
          },
          "icon": {
            "$comment": "그림 파일 이름(assets/items/<icon>.webp — 화면 소지품·장비 칸)",
            "type": "string"
          },
          "conjured": {
            "$comment": "주문이 불러낸 무기(불꽃·그늘 칼날) — 상점·전리품에 나오지 않는다",
            "type": "boolean"
          }
        }
      }
    }
  }
}
