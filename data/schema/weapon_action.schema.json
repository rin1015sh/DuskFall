{
  "$comment": "weapon_action 파일 스키마(무기 액션).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "actions"
  ],
  "properties": {
    "schema": {
      "const": "weapon_action_v1"
    },
    "note_ko": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "desc",
          "cost",
          "weapons",
          "icon",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^wa_[a-z0-9_]+$"
          },
          "name": {
            "type": "object"
          },
          "desc": {
            "type": "object"
          },
          "cost": {
            "enum": [
              "action",
              "bonus",
              "movement",
              "reaction"
            ]
          },
          "weapons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "damage": {
            "type": "string"
          },
          "damage_type": {
            "type": "string"
          },
          "save": {
            "enum": [
              "str",
              "dex",
              "con",
              "int",
              "wis",
              "cha"
            ]
          },
          "condition": {
            "type": "string"
          },
          "turns": {
            "type": "integer"
          },
          "icon": {
            "type": "string"
          },
          "source": {
            "enum": [
              "SRD 5.2.1",
              "original"
            ]
          },
          "glyph": {
            "type": "string"
          },
          "dc_bonus": {
            "type": "integer"
          },
          "dc": {
            "enum": [
              "weapon",
              "hybrid"
            ]
          },
          "max_size": {
            "enum": [
              "tiny",
              "small",
              "medium",
              "large",
              "huge",
              "gargantuan"
            ]
          },
          "move_tiles": {
            "type": "integer"
          },
          "stance": {
            "enum": [
              "brace_melee",
              "brace_ranged",
              "prepare"
            ]
          },
          "target": {
            "enum": [
              "enemy",
              "self"
            ]
          },
          "cleave_targets": {
            "type": "integer"
          },
          "half_damage": {
            "type": "boolean"
          },
          "no_mod": {
            "type": "boolean"
          },
          "needs_weapon": {
            "type": "boolean"
          },
          "charge_tiles": {
            "type": "integer"
          },
          "unlimited": {
            "type": "boolean"
          },
          "requires_turn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
