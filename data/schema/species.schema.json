{
  "$comment": "species 파일 스키마(룰북 6단계).",
  "type": "object",
  "required": [
    "schema",
    "species"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "species_v1"
    },
    "note_ko": {
      "type": "string"
    },
    "species": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "lineages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "object",
          "required": [
            "ko",
            "en"
          ],
          "additionalProperties": false,
          "properties": {
            "ko": {
              "type": [
                "string",
                "null"
              ]
            },
            "en": {
              "type": "string"
            }
          }
        },
        "parent": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "size": {
          "enum": [
            "small",
            "medium"
          ]
        },
        "size_choice": {
          "type": "array"
        },
        "body": {
          "enum": [
            "medium",
            "small",
            "dwarf"
          ]
        },
        "speed_tiles": {
          "type": "integer"
        },
        "darkvision_tiles": {
          "type": "integer"
        },
        "resistances": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "save_advantage_vs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "save_advantage_abilities": {
          "type": "array",
          "items": {
            "enum": [
              "str",
              "dex",
              "con",
              "int",
              "wis",
              "cha"
            ]
          }
        },
        "condition_immunities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hp_per_level": {
          "type": "integer"
        },
        "skill_choice": {
          "type": "object"
        },
        "origin_feat_choice": {
          "type": "boolean"
        },
        "lineage_required": {
          "type": "boolean"
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "max",
              "recharge"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "max": {
                "type": [
                  "integer",
                  "string",
                  "object"
                ]
              },
              "recharge": {
                "enum": [
                  "short",
                  "short_one",
                  "long"
                ]
              },
              "name": {
                "type": "object",
                "required": [
                  "ko",
                  "en"
                ],
                "additionalProperties": false,
                "properties": {
                  "ko": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "en": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "spells": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "level",
              "spell"
            ],
            "additionalProperties": false,
            "properties": {
              "level": {
                "type": "integer"
              },
              "spell": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "cantrip": {
                "type": "boolean"
              },
              "uses": {
                "type": [
                  "integer",
                  "string"
                ]
              }
            }
          }
        },
        "art": {
          "type": "object"
        },
        "notes_ko": {
          "type": "string"
        },
        "source": {
          "enum": [
            "SRD 5.2.1",
            "original"
          ]
        }
      }
    },
    "feature": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "object",
          "required": [
            "ko",
            "en"
          ],
          "additionalProperties": false,
          "properties": {
            "ko": {
              "type": [
                "string",
                "null"
              ]
            },
            "en": {
              "type": "string"
            }
          }
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "kind": {
          "enum": [
            "passive",
            "action",
            "bonus_action",
            "reaction",
            "free"
          ]
        },
        "hook": {
          "type": "string"
        },
        "resource": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "damage",
                  "heal",
                  "temp_hp",
                  "apply_condition",
                  "remove_condition",
                  "create_surface",
                  "create_cloud",
                  "push",
                  "teleport",
                  "summon",
                  "modify",
                  "advantage",
                  "reroll",
                  "grant_action",
                  "resource",
                  "light",
                  "dialogue_unlock"
                ]
              },
              "dice": {
                "type": "string",
                "pattern": "^-?([0-9]+d[0-9]+([+-][0-9]+)?|[0-9]+)$"
              }
            }
          }
        },
        "modifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "damage",
                  "heal",
                  "temp_hp",
                  "apply_condition",
                  "remove_condition",
                  "create_surface",
                  "create_cloud",
                  "push",
                  "teleport",
                  "summon",
                  "modify",
                  "advantage",
                  "reroll",
                  "grant_action",
                  "resource",
                  "light",
                  "dialogue_unlock"
                ]
              },
              "dice": {
                "type": "string",
                "pattern": "^-?([0-9]+d[0-9]+([+-][0-9]+)?|[0-9]+)$"
              }
            }
          }
        },
        "script": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "choices": {
          "type": "array"
        },
        "status": {
          "enum": [
            "active",
            "deferred"
          ]
        },
        "notes_ko": {
          "type": "string"
        },
        "source": {
          "enum": [
            "SRD 5.2.1",
            "original"
          ]
        },
        "caps": {
          "$comment": "엔진 메커니즘 태그(data/rules/capabilities.json)",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "grants": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "attacks_per_action": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "crit_threshold": {
              "type": "integer",
              "minimum": 15,
              "maximum": 20
            },
            "weapon_training": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "armor_training": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "extra_cantrips": {
              "type": "integer",
              "minimum": 0
            },
            "caps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "advantage": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "choice_kind": {
          "$comment": "choices를 고르는 방식: feat = 재주를 얻음, expertise = 그 기능에 전문화, option = choice_grants의 효과. 명세 키는 기능 id",
          "enum": [
            "feat",
            "expertise",
            "option"
          ]
        },
        "choice_grants": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "attacks_per_action": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "crit_threshold": {
                "type": "integer",
                "minimum": 15,
                "maximum": 20
              },
              "weapon_training": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "armor_training": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "extra_cantrips": {
                "type": "integer",
                "minimum": 0
              },
              "caps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "advantage": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        },
        "icon": {
          "$comment": "res://assets/ 아래 그림(단축 막대)",
          "type": "string"
        },
        "glyph": {
          "$comment": "행동 아이콘 문양(scenes/ui/action_icons.gd)",
          "type": "string"
        },
        "target": {
          "enum": [
            "self",
            "creature",
            "enemy",
            "cell"
          ]
        },
        "explore": {
          "$comment": "탐험 중에도 쓴다",
          "type": "boolean"
        },
        "usable": {
          "$comment": "kind가 없어도 단축 막대에 쓰는 기능으로 둔다",
          "type": "boolean"
        },
        "ai": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "when"
          ],
          "properties": {
            "when": {
              "enum": [
                "hp_below_half",
                "foes_2plus",
                "never"
              ]
            }
          }
        },
        "dice_by_level": {
          "$comment": "레벨 → 주사위(급소 공격 등)",
          "type": "object"
        },
        "toggle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "values"
          ],
          "properties": {
            "values": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "object",
                    "required": [
                      "ko",
                      "en"
                    ]
                  }
                }
              }
            },
            "desc": {
              "type": "object",
              "required": [
                "ko",
                "en"
              ]
            }
          },
          "$comment": "상시 발동 탭 설정: 누를 때마다 values를 돈다. 고른 값은 c.options[기능 id](첫 값이 기본)"
        },
        "handled_by": {
          "$comment": "다른 곳이 이 기능을 처리할 때 그곳(현황 보고서가 '설명만'으로 세지 않는다)",
          "type": "string"
        }
      }
    }
  }
}