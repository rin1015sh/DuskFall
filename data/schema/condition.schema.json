{
  "$comment": "상태이상 파일(data/rules/conditions.json) 스키마. 룰북 4단계 상태이상·환경 상태, 8단계 데이터 스키마(넘어짐 예시).",
  "type": "object",
  "required": [
    "schema",
    "conditions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "condition_v1"
    },
    "note_ko": {
      "type": "string"
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/condition"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "ability": {
      "enum": [
        "str",
        "dex",
        "con",
        "int",
        "wis",
        "cha"
      ]
    },
    "damage_type": {
      "enum": [
        "acid",
        "bludgeoning",
        "cold",
        "fire",
        "force",
        "lightning",
        "necrotic",
        "piercing",
        "poison",
        "psychic",
        "radiant",
        "slashing",
        "thunder",
        "chosen",
        "all"
      ]
    },
    "modifier": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "roll",
            "side",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "advantage"
            },
            "roll": {
              "enum": [
                "attack",
                "save",
                "ability_check",
                "initiative"
              ]
            },
            "side": {
              "enum": [
                "self",
                "against"
              ]
            },
            "value": {
              "enum": [
                "advantage",
                "disadvantage"
              ]
            },
            "range": {
              "enum": [
                "adjacent",
                "far"
              ]
            },
            "ability": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ability"
              }
            },
            "check": {
              "enum": [
                "social"
              ]
            },
            "requires": {
              "enum": [
                "source_in_sight",
                "other_is_source",
                "other_not_source"
              ]
            },
            "unless": {
              "enum": [
                "other_sees_invisible",
                "attacker_cannot_see"
              ]
            },
            "attacker_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "spell_attack": {
              "$comment": "주문 공격에만",
              "type": "boolean"
            },
            "skill": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "stat"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "modify"
            },
            "stat": {
              "enum": [
                "ac",
                "speed_tiles",
                "damage_resistance",
                "damage_vulnerability",
                "damage_immunity",
                "no_reactions",
                "jump_tiles",
                "rage_damage",
                "spell_dc",
                "str_weapon_damage"
              ]
            },
            "add": {
              "type": "integer"
            },
            "set": {
              "type": "integer"
            },
            "damage_types": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/damage_type"
              }
            },
            "floor": {
              "$comment": "stat ac: AC가 이보다 낮으면 이 값(나무껍질 피부)",
              "type": "integer"
            },
            "multiply": {
              "$comment": "곱하기(무게 초과 이동·도약 — 더하기 뒤에 곱하고 내림)",
              "type": "number"
            }
          }
        }
      ]
    },
    "hook_effect": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "damage",
            "heal",
            "temp_hp",
            "apply_condition",
            "remove_condition",
            "save"
          ]
        },
        "dice": {
          "type": "string",
          "pattern": "^-?([0-9]+d[0-9]+([+-][0-9]+)?|[0-9]+)$"
        },
        "damage_type": {
          "$ref": "#/$defs/damage_type"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "requires": {
          "enum": [
            "weapon_attack"
          ]
        },
        "save": {
          "$comment": "on_weapon_hit: 대상 내성(실패 시 on_fail) — DC는 상태를 건 시전자의 주문 DC",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ability"
          ],
          "properties": {
            "ability": {
              "$ref": "#/$defs/ability"
            },
            "large_advantage": {
              "type": "boolean"
            }
          }
        },
        "on_fail": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook_effect"
          }
        },
        "per_slot": {
          "$comment": "on_weapon_hit damage: 상위 슬롯마다 더하는 주사위",
          "type": "string"
        },
        "bonus_vs": {
          "$comment": "대상 종류가 types면 dice를 더한다",
          "type": "object",
          "properties": {
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dice": {
              "type": "string"
            }
          }
        },
        "apply": {
          "$comment": "on_weapon_hit damage: 맞힌 대상에게 상태 {id, turns, repeat_save{ability}, dot_dice}",
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "amount": {
          "$comment": "temp_hp: source_spell_mod = 상태를 건 시전자의 주문 능력 수정치, heal: 회복량(정수 — 재생)",
          "oneOf": [
            {
              "enum": [
                "source_spell_mod"
              ]
            },
            {
              "type": "integer"
            }
          ]
        }
      }
    },
    "condition": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "stack",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "object",
          "required": [
            "ko",
            "en"
          ],
          "additionalProperties": false,
          "properties": {
            "ko": {
              "type": [
                "string",
                "null"
              ]
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "category": {
          "enum": [
            "srd",
            "environment",
            "spell",
            "combat"
          ]
        },
        "stack": {
          "enum": [
            "keep_longest"
          ]
        },
        "default_duration_turns": {
          "type": "integer",
          "minimum": 1
        },
        "includes": {
          "$ref": "#/$defs/id_list"
        },
        "also_applies": {
          "$ref": "#/$defs/id_list"
        },
        "condition_immunities": {
          "$ref": "#/$defs/id_list"
        },
        "removes_on_apply": {
          "$ref": "#/$defs/id_list"
        },
        "suppresses": {
          "$ref": "#/$defs/id_list"
        },
        "modifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modifier"
          }
        },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "incapacitated": {
              "type": "boolean"
            },
            "cannot_speak": {
              "type": "boolean"
            },
            "speed_zero": {
              "type": "boolean"
            },
            "reroll_failed_d20": {
              "type": "boolean"
            },
            "death_ward": {
              "type": "boolean"
            },
            "one_thing_only": {
              "type": "boolean"
            },
            "auto_fail_saves": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ability"
              }
            },
            "auto_crit_within_tiles": {
              "type": "integer",
              "minimum": 1
            },
            "cannot_attack_source": {
              "type": "boolean"
            },
            "cannot_approach_source": {
              "type": "boolean"
            },
            "concealed": {
              "type": "boolean"
            },
            "drops_held": {
              "type": "boolean"
            },
            "fails_sight_checks": {
              "type": "boolean"
            },
            "weight_multiplier": {
              "type": "number",
              "minimum": 0
            },
            "cannot_act": {
              "type": "boolean"
            },
            "flying": {
              "type": "boolean"
            },
            "climber": {
              "type": "boolean"
            },
            "ethereal": {
              "type": "boolean"
            },
            "water_walk": {
              "type": "boolean"
            },
            "no_spellcasting": {
              "type": "boolean"
            },
            "no_jump": {
              "type": "boolean"
            },
            "no_climb": {
              "type": "boolean"
            },
            "action_minus_one": {
              "type": "boolean"
            },
            "no_dex_ac": {
              "type": "boolean"
            },
            "disarmed": {
              "type": "boolean"
            }
          }
        },
        "movement": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "crawl": {
              "type": "boolean"
            },
            "stand_up_cost": {
              "enum": [
                "half_speed"
              ]
            }
          }
        },
        "hooks": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^on_[a-z_]+$": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/hook_effect"
              }
            }
          }
        },
        "notes_ko": {
          "type": "string"
        },
        "source": {
          "enum": [
            "SRD 5.2.1",
            "original"
          ]
        },
        "transfer_on_drop": {
          "$comment": "이 상태를 지닌 생물이 0 HP가 되면 건 시전자가 볼 수 있는 가장 가까운 적(range 칸 안)에게 자동으로 옮긴다(사냥꾼의 표식 — 사용자 결정 2026-11-23)",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "range"
          ],
          "properties": {
            "range": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "consume_on_trigger": {
          "$comment": "on_weapon_hit가 한 번 발동하면 이 상태를 지운다",
          "type": "boolean"
        },
        "load_kg_per_str": {
          "$comment": "무게 상태(BG3식 — interact.update_load): 들고 있는 kg이 근력 × 이 값을 넘으면 자동으로 건다",
          "type": "number"
        },
        "melee_only": {
          "$comment": "on_weapon_hit: 근접 무기·비무장 명중에만(강타)",
          "type": "boolean"
        },
        "ends_on_attack": {
          "$comment": "이 상태로 공격 굴림을 하면 끝난다(조롱당함)",
          "type": "boolean"
        },
        "lifted_by_cap": {
          "$comment": "이 능력 태그가 있으면 이 상태의 no_spellcasting을 무시(야수 주문)",
          "type": "string"
        },
        "retaliate": {
          "$comment": "1칸 안 근접 명중 시 공격자에게 피해 {dice, damage_type}(화염 방패)",
          "type": "object"
        },
        "reveals_defenses": {
          "$comment": "건 생물이 능력 태그 hunters_lore면 대상의 면역·저항·취약을 안다",
          "type": "boolean"
        },
        "ends_on_heal": {
          "type": "boolean",
          "description": "회복을 받으면 풀린다(BG3 출혈·불구 등)"
        },
        "ends_on_damage": {
          "type": "boolean",
          "description": "피해를 받으면 풀린다(BG3 균형 잃음)"
        },
        "helpable": {
          "type": "boolean",
          "description": "돕기 행동으로 풀린다(BG3)"
        },
        "immune_creature_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "이 생물 종류는 걸리지 않는다"
        },
        "hit_against_damage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "amount": {
              "type": "integer"
            },
            "damage_type": {
              "type": "string"
            }
          },
          "description": "이 생물을 맞힌 공격에 고정 피해 추가"
        },
        "ends_on_attacked": {
          "type": "boolean"
        },
        "move_damage": {
          "type": "object"
        }
      }
    }
  }
}
