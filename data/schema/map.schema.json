{
  "$comment": "맵 파일 스키마(룰북 8단계 '무기와 맵 칸': 레이어별 2차원 배열). 첫 판: 글자 지도 + 범례.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "legend",
    "rows",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "map_v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "object",
      "required": [
        "ko",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "ko": {
          "type": [
            "string",
            "null"
          ]
        },
        "en": {
          "type": "string"
        }
      }
    },
    "note_ko": {
      "type": "string"
    },
    "legend": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^.$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "material": {
              "type": "string"
            },
            "surface": {
              "type": "string"
            },
            "height": {
              "type": "integer",
              "minimum": 0
            },
            "flags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "light": {
      "enum": [
        "bright",
        "dim",
        "dark"
      ]
    },
    "light_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "cell",
          "bright"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "cell": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "bright": {
            "type": "integer",
            "minimum": 0
          },
          "dim": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cell",
          "flags"
        ],
        "additionalProperties": false,
        "properties": {
          "cell": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rect"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "rect": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cell",
          "id",
          "material",
          "hp"
        ],
        "additionalProperties": false,
        "properties": {
          "cell": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "id": {
            "type": "string"
          },
          "material": {
            "type": "string"
          },
          "hp": {
            "type": "integer",
            "minimum": 1
          },
          "ac": {
            "type": "integer"
          },
          "weight_kg": {
            "type": "number"
          },
          "blocks_movement": {
            "type": "boolean"
          },
          "contents": {
            "type": "object",
            "required": [
              "surface"
            ],
            "additionalProperties": false,
            "properties": {
              "surface": {
                "type": "string"
              },
              "radius": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "spawns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "cell"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "cell": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "source": {
      "enum": [
        "SRD 5.2.1",
        "original"
      ]
    }
  }
}