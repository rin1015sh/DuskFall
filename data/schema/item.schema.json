{
  "$comment": "item 파일 스키마(룰북 6단계).",
  "type": "object",
  "required": [
    "schema",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "item_v1"
    },
    "note_ko": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "rarity",
        "weight_kg",
        "price_gp",
        "material",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "object",
          "required": [
            "ko",
            "en"
          ],
          "additionalProperties": false,
          "properties": {
            "ko": {
              "type": [
                "string",
                "null"
              ]
            },
            "en": {
              "type": "string"
            }
          }
        },
        "category": {
          "enum": [
            "potion",
            "scroll",
            "food",
            "tool",
            "magic",
            "misc"
          ]
        },
        "rarity": {
          "enum": [
            "common",
            "uncommon",
            "rare",
            "very_rare",
            "legendary"
          ]
        },
        "weight_kg": {
          "type": "number"
        },
        "price_gp": {
          "type": "number"
        },
        "material": {
          "type": "string"
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "damage",
                  "heal",
                  "temp_hp",
                  "apply_condition",
                  "remove_condition",
                  "create_surface",
                  "create_cloud",
                  "push",
                  "teleport",
                  "summon",
                  "modify",
                  "advantage",
                  "reroll",
                  "grant_action",
                  "resource",
                  "light",
                  "dialogue_unlock"
                ]
              },
              "dice": {
                "type": "string",
                "pattern": "^-?([0-9]+d[0-9]+([+-][0-9]+)?|[0-9]+)$"
              }
            }
          }
        },
        "drink_cost": {
          "enum": [
            "bonus_action",
            "action"
          ]
        },
        "feed_cost": {
          "enum": [
            "bonus_action",
            "action"
          ]
        },
        "throwable": {
          "type": "boolean"
        },
        "throw": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "area": {
              "enum": [
                "cross"
              ]
            },
            "removes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            }
          }
        },
        "camp_supplies": {
          "type": "integer"
        },
        "source": {
          "enum": [
            "SRD 5.2.1",
            "original"
          ]
        },
        "spell": {
          "$comment": "두루마리(category scroll): 시전하는 주문",
          "type": "string"
        },
        "save_dc": {
          "$comment": "두루마리 내성 DC(SRD: 소마법·1레벨 13)",
          "type": "integer"
        },
        "attack_bonus": {
          "$comment": "두루마리 주문 공격 보너스(SRD: 소마법·1레벨 +5)",
          "type": "integer"
        }
      }
    },
    "feature": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
