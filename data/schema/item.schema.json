              ]
            },
            "en": {
              "type": "string"
            }
          }
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "kind": {
          "enum": [
            "passive",
            "action",
            "bonus_action",
            "reaction",
            "free"
          ]
        },
        "hook": {
          "type": "string"
        },
        "resource": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "damage",
                  "heal",
                  "temp_hp",
                  "apply_condition",
                  "remove_condition",
                  "create_surface",
                  "create_cloud",
                  "push",
                  "teleport",
                  "summon",
                  "modify",
                  "advantage",
                  "reroll",
                  "grant_action",
                  "resource",
                  "light",
                  "dialogue_unlock"
                ]
              },
              "dice": {
                "type": "string",
                "pattern": "^-?([0-9]+d[0-9]+([+-][0-9]+)?|[0-9]+)$"
              }
            }
          }
        },
        "modifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "damage",
                  "heal",
                  "temp_hp",
                  "apply_condition",
                  "remove_condition",
                  "create_surface",
                  "create_cloud",
                  "push",
                  "teleport",
                  "summon",
                  "modify",
                  "advantage",
                  "reroll",
                  "grant_action",
                  "resource",
                  "light",
                  "dialogue_unlock"
                ]
              },
              "dice": {
                "type": "string",
                "pattern": "^-?([0-9]+d[0-9]+([+-][0-9]+)?|[0-9]+)$"
              }
            }
          }
        },
        "script": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "choices": {
          "type": "array"
        },
        "status": {
          "enum": [
            "active",
            "deferred"
          ]
        },
        "notes_ko": {
          "type": "string"
        },
        "source": {
          "enum": [
            "SRD 5.2.1",
            "original"
          ]
        }
      }
    }
  }
